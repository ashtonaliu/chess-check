# Copy to .env and fill in. .env is gitignored.

# Coach (optional): an Anthropic API key. Without it, the local app uses Claude Code if installed.
ANTHROPIC_API_KEY=

# MySQL backend (docker compose). Pick your own passwords.
MYSQL_ROOT_PASSWORD=
CHESS_CHECK_WRITER_PASSWORD=
CHESS_CHECK_READER_PASSWORD=
# For running the app outside Docker against the compose MySQL:
# CHESS_CHECK_SQL_BACKEND=mysql
# CHESS_CHECK_MYSQL_WRITER_URL=mysql://chesscheck_writer:<password>@127.0.0.1:3306
# CHESS_CHECK_MYSQL_READER_URL=mysql://chesscheck_reader:<password>@127.0.0.1:3306
