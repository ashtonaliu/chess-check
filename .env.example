# Copy to .env and fill in. .env is gitignored.

# Coach (optional): an Anthropic API key. Without it, the local app uses Claude Code if installed.
ANTHROPIC_API_KEY=

# MySQL backend (docker compose). Pick your own passwords.
MYSQL_ROOT_PASSWORD=
WF_WRITER_PASSWORD=
WF_READER_PASSWORD=
# For running the app outside Docker against the compose MySQL:
# WF_SQL_BACKEND=mysql
# WF_MYSQL_WRITER_URL=mysql://wf_writer:<password>@127.0.0.1:3306
# WF_MYSQL_READER_URL=mysql://wf_reader:<password>@127.0.0.1:3306
