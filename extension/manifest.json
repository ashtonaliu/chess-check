{
  "manifest_version": 3,
  "name": "Weakness Finder: post-game recaps",
  "short_name": "Weakness Finder",
  "version": "0.1.0",
  "description": "A short recap after each Chess.com game you finish: the upset meter, the turning point, your patterns and your opponent's openings. Never during a game.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.chess.com/*", "https://api.chess.com/*"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Weakness Finder recaps", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
