{
  "name": "weakness-finder-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && rm -f dist/*.js && esbuild src/main.ts --bundle --format=esm --target=es2020 --splitting --outdir=dist --chunk-names=chunks/[name]-[hash] && npm run copy-engine",
    "typecheck": "tsc --noEmit",
    "copy-engine": "mkdir -p dist/engine && cp node_modules/stockfish/bin/stockfish-19-lite-single.js node_modules/stockfish/bin/stockfish-19-lite-single.wasm dist/engine/",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "stockfish": "19.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@duckdb/duckdb-wasm": "1.32.0",
    "chess.js": "1.4.0"
  }
}
